# Gmail pengirim (alamat lengkap)
SMTP_USER=your-address@gmail.com

# App Password Gmail 16 digit (Google Account > Security > App passwords)
SMTP_PASS=xxxx xxxx xxxx xxxx

# Penerima (kosongkan untuk kirim ke SMTP_USER)
NOTIFY_TO=

# Kirim email saat baterai discharging di bawah persen ini
NOTIFY_THRESHOLD=20
